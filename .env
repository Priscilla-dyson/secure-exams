# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Update this with your PostgreSQL connection string
DATABASE_URL="postgresql://postgres:prie1212@localhost:5432/secure_exams?schema=public"

# JWT Secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# SMTP Configuration for Email Notifications
# ─────────────────────────────────────────────────────────────
# To send real emails, you need to configure an SMTP server.
# Here are two easy options:
#
# OPTION 1: GMAIL (Free)
# 1. Go to https://myaccount.google.com/security
# 2. Turn ON "2-Step Verification" if not already on
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Windows Computer", then click "Generate"
# 5. Copy the 16-character password it gives you
# 6. Fill in the settings below:
#
#    SMTP_HOST="smtp.gmail.com"
#    SMTP_PORT="587"
#    SMTP_SECURE="false"
#    SMTP_USER="your-email@gmail.com"
#    SMTP_PASS="your-16-character-app-password"
#    SMTP_FROM="your-email@gmail.com"
#
# OPTION 2: Use a testing service (no real emails sent)
# Leave all SMTP fields empty - emails will be logged to the 
# server console so you can see they would have been sent.
#
# ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@university.edu"
APP_URL="http://localhost:3000"